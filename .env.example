# ===== الأساسيات =====
PORT=3000
NODE_ENV=development
# مفتاح سري طويل وعشوائي (مهم جداً في الإنتاج) - يُستخدم لتجزئة رموز OTP
APP_SECRET=change-me-to-a-long-random-string
# أول مدير للنظام (يُنشأ تلقائياً عند أول تشغيل إن لم يوجد أي مدير)
ADMIN_PHONE=+96890000000
ADMIN_NAME=مدير النظام
# فارق التوقيت المحلي بالدقائق عن UTC (سلطنة عُمان = 240، بلا توقيت صيفي)
TZ_OFFSET_MIN=240
DEFAULT_COUNTRY=OM

# ===== إرسال الرسائل =====
# console  : يطبع الرمز في سجل الخادم فقط (للتجربة)
# whatsapp_cloud : واجهة واتساب السحابية من Meta
# twilio   : Twilio (واتساب + SMS كبديل)
MESSAGE_PROVIDER=console
# هل يُعاد رمز OTP في الاستجابة؟ للتجربة المحلية فقط (يُتجاهل في الإنتاج)
DEV_SHOW_OTP=1
# بديل SMS عند فشل واتساب: none | twilio
SMS_FALLBACK=none

# --- Meta WhatsApp Cloud API ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# قالب رسالة OTP المعتمد (Authentication template) إن وُجد، وإلا تُرسل رسالة نصية عادية
WA_OTP_TEMPLATE=
WA_OTP_TEMPLATE_LANG=ar
# قالب التذكير (متغيّران: اسم المستخدم، عنوان المهمة) إن وُجد
WA_REMINDER_TEMPLATE=
WA_REMINDER_TEMPLATE_LANG=ar

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# دخول مباشر للتجربة المحلية فقط (/dev-login) — لا تفعّله على خادم عام
# DEV_LOGIN=1

# --- قوالب واتساب المعتمدة لإشعارات المجتمع (اختيارية؛ وإلا تُرسل رسائل نصية) ---
WA_TPL_POST_PUBLISHED=
WA_TPL_POST_NEEDS_EDIT=
WA_TPL_POST_REJECTED=
WA_TPL_REVIEW_DIGEST=

# عنوان الموقع العام (يُستعمل في روابط بطاقات الإهداء المرسلة عبر واتساب)، مثل https://mathani.example
# PUBLIC_URL=
# قوالب واتساب المعتمدة لرسائل الإهداء (اختيارية؛ وإلا تُرسل رسائل نصية)
WA_TPL_GIFT_CARD=
WA_TPL_GIFT_REMINDER=
